validateUsername:
SELECT * FROM Usuario_Vendedor WHERE usuario = ?;

products:
SELECT * FROM Producto;

createUser:
INSERT INTO Usuario_Vendedor (nombre, apellido, cedula, celular, codigo_vendedor, usuario, contrasena)
VALUES (?, ?, ?, ?, ?, ?, ?);
